# ==========================================
# APP CONFIGURATIONS
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# FIREBASE ADMIN SDK (Credenciais do Servidor)
# ==========================================
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=seu-client-email@seu-project-id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=seu-project-id.firebasestorage.app

# Cole aqui a private key completa mantendo as aspas duplas e os \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEnfieSuaChaveComForçaAqui\n-----END PRIVATE KEY-----\n"

# ==========================================
# CLIENT API KEYS (Opcional se usar apenas Admin SDK)
# ==========================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=